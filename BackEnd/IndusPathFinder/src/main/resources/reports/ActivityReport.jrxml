<?xml version="1.0" encoding="UTF-8"?>

<jasperReport
    xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
                        http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="ActivityReport"
    language="java"
    pageWidth="842"
    pageHeight="595"
    orientation="Landscape"
    columnWidth="802"
    leftMargin="20"
    rightMargin="20"
    topMargin="20"
    bottomMargin="20">

    <parameter name="reportTitle"
               class="java.lang.String"/>

    <parameter name="projectId"
               class="java.lang.Long"/>

    <parameter name="projectCode"
               class="java.lang.String"/>

    <parameter name="projectName"
               class="java.lang.String"/>

    <field name="activityId"
           class="java.lang.Long"/>

    <field name="projectId"
           class="java.lang.Long"/>

    <field name="projectCode"
           class="java.lang.String"/>

    <field name="activityCode"
           class="java.lang.String"/>

    <field name="activityName"
           class="java.lang.String"/>

    <field name="description"
           class="java.lang.String"/>

    <field name="duration"
           class="java.lang.Integer"/>

    <field name="startDate"
           class="java.lang.String"/>

    <field name="endDate"
           class="java.lang.String"/>

    <field name="priority"
           class="java.lang.String"/>

    <field name="status"
           class="java.lang.String"/>

    <title>
        <band height="65">

            <textField>
                <reportElement
                    x="0"
                    y="0"
                    width="802"
                    height="30"/>

                <textElement textAlignment="Center">
                    <font size="18"
                          isBold="true"/>
                </textElement>

                <textFieldExpression
                    class="java.lang.String"><![CDATA[
                    $P{reportTitle}
                ]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement
                    x="0"
                    y="35"
                    width="802"
                    height="20"/>

                <textElement textAlignment="Center"/>

                <textFieldExpression
                    class="java.lang.String"><![CDATA[
                    "Project: "
                    + $P{projectCode}
                    + " - "
                    + $P{projectName}
                ]]></textFieldExpression>
            </textField>

        </band>
    </title>

    <columnHeader>
        <band height="30">

            <staticText>
                <reportElement x="0" y="0"
                               width="45" height="30"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[ID]]></text>
            </staticText>

            <staticText>
                <reportElement x="45" y="0"
                               width="65" height="30"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Project ID]]></text>
            </staticText>

            <staticText>
                <reportElement x="110" y="0"
                               width="75" height="30"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Project Code]]></text>
            </staticText>

            <staticText>
                <reportElement x="185" y="0"
                               width="80" height="30"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Activity Code]]></text>
            </staticText>

            <staticText>
                <reportElement x="265" y="0"
                               width="110" height="30"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Activity Name]]></text>
            </staticText>

            <staticText>
                <reportElement x="375" y="0"
                               width="120" height="30"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Description]]></text>
            </staticText>

            <staticText>
                <reportElement x="495" y="0"
                               width="55" height="30"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Duration]]></text>
            </staticText>

            <staticText>
                <reportElement x="550" y="0"
                               width="70" height="30"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Start Date]]></text>
            </staticText>

            <staticText>
                <reportElement x="620" y="0"
                               width="70" height="30"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[End Date]]></text>
            </staticText>

            <staticText>
                <reportElement x="690" y="0"
                               width="55" height="30"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Priority]]></text>
            </staticText>

            <staticText>
                <reportElement x="745" y="0"
                               width="57" height="30"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Status]]></text>
            </staticText>

        </band>
    </columnHeader>

    <detail>
        <band height="35">

            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0"
                               width="45" height="35"/>
                <textFieldExpression
                    class="java.lang.Long"><![CDATA[
                    $F{activityId}
                ]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="45" y="0"
                               width="65" height="35"/>
                <textFieldExpression
                    class="java.lang.Long"><![CDATA[
                    $F{projectId}
                ]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="110" y="0"
                               width="75" height="35"/>
                <textFieldExpression
                    class="java.lang.String"><![CDATA[
                    $F{projectCode}
                ]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="185" y="0"
                               width="80" height="35"/>
                <textFieldExpression
                    class="java.lang.String"><![CDATA[
                    $F{activityCode}
                ]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="265" y="0"
                               width="110" height="35"/>
                <textFieldExpression
                    class="java.lang.String"><![CDATA[
                    $F{activityName}
                ]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="375" y="0"
                               width="120" height="35"/>
                <textFieldExpression
                    class="java.lang.String"><![CDATA[
                    $F{description}
                ]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="495" y="0"
                               width="55" height="35"/>
                <textFieldExpression
                    class="java.lang.Integer"><![CDATA[
                    $F{duration}
                ]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="550" y="0"
                               width="70" height="35"/>
                <textFieldExpression
                    class="java.lang.String"><![CDATA[
                    $F{startDate}
                ]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="620" y="0"
                               width="70" height="35"/>
                <textFieldExpression
                    class="java.lang.String"><![CDATA[
                    $F{endDate}
                ]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="690" y="0"
                               width="55" height="35"/>
                <textFieldExpression
                    class="java.lang.String"><![CDATA[
                    $F{priority}
                ]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="745" y="0"
                               width="57" height="35"/>
                <textFieldExpression
                    class="java.lang.String"><![CDATA[
                    $F{status}
                ]]></textFieldExpression>
            </textField>

        </band>
    </detail>

    <pageFooter>
        <band height="25">

            <textField>
                <reportElement
                    x="650"
                    y="5"
                    width="152"
                    height="20"/>

                <textElement textAlignment="Right"/>

                <textFieldExpression
                    class="java.lang.String"><![CDATA[
                    "Page " + $V{PAGE_NUMBER}
                ]]></textFieldExpression>
            </textField>

        </band>
    </pageFooter>

</jasperReport>