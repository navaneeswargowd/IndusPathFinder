<?xml version="1.0" encoding="UTF-8"?>

<jasperReport
    xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://jasperreports.sourceforge.net/jasperreports
        http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="CPMReport"
    pageWidth="842"
    pageHeight="595"
    orientation="Landscape"
    columnWidth="802"
    leftMargin="20"
    rightMargin="20"
    topMargin="20"
    bottomMargin="20">

    <parameter name="reportTitle" class="java.lang.String"/>
    <parameter name="projectId" class="java.lang.Long"/>
    <parameter name="projectCode" class="java.lang.String"/>
    <parameter name="projectName" class="java.lang.String"/>
    <parameter name="projectDuration" class="java.lang.Integer"/>
    <parameter name="criticalPath" class="java.lang.String"/>

    <field name="activityId" class="java.lang.Long"/>
    <field name="activityCode" class="java.lang.String"/>
    <field name="activityName" class="java.lang.String"/>
    <field name="duration" class="java.lang.Integer"/>
    <field name="earliestStart" class="java.lang.Integer"/>
    <field name="earliestFinish" class="java.lang.Integer"/>
    <field name="latestStart" class="java.lang.Integer"/>
    <field name="latestFinish" class="java.lang.Integer"/>
    <field name="critical" class="java.lang.Boolean"/>

    <title>
        <band height="85">

            <textField>
                <reportElement x="0" y="0" width="802" height="30"/>
                <textElement textAlignment="Center">
                    <font size="18" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{reportTitle}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="32" width="400" height="20"/>
                <textFieldExpression>
                    <![CDATA[
                        "Project: "
                        + $P{projectCode}
                        + " - "
                        + $P{projectName}
                    ]]>
                </textFieldExpression>
            </textField>

            <textField>
                <reportElement x="400" y="32" width="402" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression>
                    <![CDATA[
                        "Project Duration: "
                        + $P{projectDuration}
                    ]]>
                </textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="55" width="802" height="25"/>
                <textFieldExpression>
                    <![CDATA[
                        "Critical Path: "
                        + $P{criticalPath}
                    ]]>
                </textFieldExpression>
            </textField>

        </band>
    </title>

    <columnHeader>
        <band height="35">

            <staticText>
                <reportElement x="0" y="0" width="60" height="35"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[ID]]></text>
            </staticText>

            <staticText>
                <reportElement x="60" y="0" width="90" height="35"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Code]]></text>
            </staticText>

            <staticText>
                <reportElement x="150" y="0" width="180" height="35"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Activity Name]]></text>
            </staticText>

            <staticText>
                <reportElement x="330" y="0" width="65" height="35"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Duration]]></text>
            </staticText>

            <staticText>
                <reportElement x="395" y="0" width="70" height="35"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[EST]]></text>
            </staticText>

            <staticText>
                <reportElement x="465" y="0" width="70" height="35"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[EFT]]></text>
            </staticText>

            <staticText>
                <reportElement x="535" y="0" width="70" height="35"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[LST]]></text>
            </staticText>

            <staticText>
                <reportElement x="605" y="0" width="70" height="35"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[LFT]]></text>
            </staticText>

            <staticText>
                <reportElement x="675" y="0" width="127" height="35"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Critical]]></text>
            </staticText>

        </band>
    </columnHeader>

    <detail>
        <band height="35">

            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="60" height="35"/>
                <textFieldExpression><![CDATA[$F{activityId}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="60" y="0" width="90" height="35"/>
                <textFieldExpression><![CDATA[$F{activityCode}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="150" y="0" width="180" height="35"/>
                <textFieldExpression><![CDATA[$F{activityName}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="330" y="0" width="65" height="35"/>
                <textFieldExpression><![CDATA[$F{duration}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="395" y="0" width="70" height="35"/>
                <textFieldExpression><![CDATA[$F{earliestStart}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="465" y="0" width="70" height="35"/>
                <textFieldExpression><![CDATA[$F{earliestFinish}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="535" y="0" width="70" height="35"/>
                <textFieldExpression><![CDATA[$F{latestStart}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="605" y="0" width="70" height="35"/>
                <textFieldExpression><![CDATA[$F{latestFinish}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="675" y="0" width="127" height="35"/>
                <textFieldExpression>
                    <![CDATA[
                        Boolean.TRUE.equals($F{critical})
                            ? "YES"
                            : "NO"
                    ]]>
                </textFieldExpression>
            </textField>

        </band>
    </detail>

    <pageFooter>
        <band height="25">
            <textField>
                <reportElement x="650" y="5" width="152" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression>
                    <![CDATA["Page " + $V{PAGE_NUMBER}]]>
                </textFieldExpression>
            </textField>
        </band>
    </pageFooter>

</jasperReport>